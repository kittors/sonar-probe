{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  // 测试用 node --test 直接跑 .ts 源码（strip-types 要求写 .ts 后缀，而 tsc 不允许），
  // 而且测试也不该进构建产物
  "exclude": ["src/**/*.test.ts"]
}
